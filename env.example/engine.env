## =============================================================
## Credentials
## =============================================================
# DFE_ENGINE_AUTH_BREAKGLASS_PASSWORD=
# DFE_ENGINE_AUTH_LOCAL_ADMIN_NAME=admin
# DFE_ENGINE_AUTH_LOCAL_ADMIN_PASSWORD=

## =============================================================
## Deploy Repo
## =============================================================
# DFE_ENGINE_GITOPS_FORGE_API_BASE=
# DFE_ENGINE_GITOPS_FORGE_PROVIDER=
# DFE_ENGINE_GITOPS_REPO_URL=
# DFE_ENGINE_GITOPS_TOKEN=
# DFE_ENGINE_GITOPS_USERNAME=

## =============================================================
## OIDC
## =============================================================
# DFE_GOOGLE_SA_JSON=
# DFE_OIDC_DEX_CLIENT_ID=
# DFE_OIDC_DEX_CLIENT_SECRET=
# DFE_OIDC_ENTRA_CLIENT_ID=
# DFE_OIDC_ENTRA_CLIENT_SECRET=
# DFE_OIDC_GOOGLE_CLIENT_ID=
# DFE_OIDC_GOOGLE_CLIENT_SECRET=
# DFE_OIDC_OKTA_CLIENT_ID=
# DFE_OIDC_OKTA_CLIENT_SECRET=
# SSL_CERT_FILE=/etc/ssl/certs/idp-bundle.crt

## =============================================================
## ClickHouse
## =============================================================
# DFE_ENGINE_CLICKHOUSE_DEFAULT_TTL_DAYS=90

## =============================================================
## Metrics
## =============================================================
# DFE_ENGINE_API_METRICS_BACKEND=opentelemetry
