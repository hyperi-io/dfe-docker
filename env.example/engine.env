## Project:   dfe-docker
## File:      env.example/engine.env
## Purpose:   Environment variables for dfe-engine
## Language:  Bash (dotenv)
##
## License:   BUSL-1.1
## Copyright: (c) 2026 HYPERI PTY LIMITED

## =============================================================
## Credentials
## =============================================================
## Minted by `make init`, handed over by `make creds`
# DFE_API_JWT_SECRET=
# DFE_AUTH_BREAKGLASS_PASSWORD=
# DFE_AUTH_LOCAL_ADMIN_PASSWORD=

## =============================================================
## OIDC
## =============================================================
## Read by the provider files in /app/config/auth/oidc-providers
# DFE_GOOGLE_SA_JSON=
# DFE_OIDC_DEX_CLIENT_ID=
# DFE_OIDC_DEX_CLIENT_SECRET=
# DFE_OIDC_ENTRA_CLIENT_ID=
# DFE_OIDC_ENTRA_CLIENT_SECRET=
# DFE_OIDC_GOOGLE_CLIENT_ID=
# DFE_OIDC_GOOGLE_CLIENT_SECRET=
# DFE_OIDC_OKTA_CLIENT_ID=
# DFE_OIDC_OKTA_CLIENT_SECRET=

## A full CA bundle, for an IdP on a private CA
# SSL_CERT_FILE=/etc/ssl/certs/idp-bundle.crt

## =============================================================
## Deployment
## =============================================================
## Keeps the break-glass login across a rebuild
DFE_GITOPS_ENABLED=true

## =============================================================
## ClickHouse
## =============================================================
## Default retention in days, 0 for none
# DFE_CLICKHOUSE_DEFAULT_TTL_DAYS=90

## =============================================================
## Metrics
## =============================================================
## `prometheus` stops the push to the collector
# DFE_API_METRICS_BACKEND=opentelemetry
