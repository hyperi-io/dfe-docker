## ============================================================================
## Logging / Telemetry
## ============================================================================
#
# HYPERDX_LOG_LEVEL=info
# USAGE_STATS_ENABLED=false

## ============================================================================
## ClickHouse Sources
## ============================================================================
#
# DEFAULT_SOURCES=

## ============================================================================
## Auth
## ============================================================================
## Neither of these applies in Docker mode. The stack ships god-mode -- HyperDX
## runs with NEXT_PUBLIC_IS_LOCAL_MODE=true and there is no OIDC proxy in front
## of anything. `oidc-proxy` is the Kubernetes posture, kept here so the two
## deployments share one template. Setting it here buys you nothing; put the app
## behind a VPN, a tunnel or an authenticating proxy instead.
#
# DFE_AUTH_MODE=oidc-proxy
# HYPERDX_API_KEY=