## ============================================================================
## Authentication
## ============================================================================
## NEXTAUTH_SECRET is NOT set here. docker-compose.yml forwards
## DFE_UI_NEXTAUTH_SECRET from .env, which `make init` generates -- and a
## commented placeholder in this file is exactly how the literal "secret"
## became what actually ran.
# NEXTAUTH_URL=http://localhost:3000

## ============================================================================
## API
## ============================================================================
INTERNAL_API_URL=http://dfe-engine:8000
# NEXT_PUBLIC_API_URL=http://localhost:8003

## ============================================================================
## DevAlerts
## ============================================================================
# NEXT_PUBLIC_DEV_ALERTS=true

## ============================================================================
## Auth Session / Token Refresh
## ============================================================================
# NEXT_PUBLIC_ACCESS_TOKEN_MIN_REFRESH_INTERVAL_MS=120000
# NEXT_PUBLIC_ACCESS_TOKEN_REFRESH_BUFFER_MS=300000
# NEXT_PUBLIC_ACCESS_TOKEN_SESSION_CHECK_INTERVAL_MS=60000
# NEXT_PUBLIC_SESSION_REFETCH_INTERVAL_SECONDS=300

# =============================================================================
# Auth (RBAC)
# =============================================================================
# Local accounts (bootstrapped when local auth is enabled)
# This should have the same value as dfe-engine.env.example DFE_AUTH_LOCAL_ADMIN_NAME & DFE_AUTH_LOCAL_ADMIN_PASSWORD
NEXT_PUBLIC_DFE_AUTH_LOCAL_ADMIN_NAME=admin
NEXT_PUBLIC_DFE_AUTH_LOCAL_ADMIN_PASSWORD=changeme
