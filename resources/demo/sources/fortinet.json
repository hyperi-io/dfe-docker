{
  "archive": true,
  "description": "The log data stream of the Elastic fortinet_fortigate integration.",
  "display_name": "fortinet_fortigate.log",
  "from_catalogue_intake": "receiver",
  "from_catalogue_item": "fortinet",
  "match": {
    "field": "_source",
    "operator": "equals",
    "value": "fortinet"
  },
  "schema": {
    "additional_fields": "additional/fortinet_fortigate/log",
    "derived_schema": "derived/fortinet_fortigate/log",
    "meta_schema": "meta/elastic/ecs"
  },
  "source": "fortinet",
  "state": "dormant",
  "transform": {
    "engine": "elastic",
    "variant": "filebeat.fortinet.default"
  }
}
