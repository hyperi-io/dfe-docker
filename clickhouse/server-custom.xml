<clickhouse>
  <!-- Mirrors the k8s single-node ConfigMap in dfe-infra
       (helm/charts/clickhouse-cluster/templates/clickhouse-single.yaml) so the
       two targets present the same ClickHouse to the engine. -->
  <custom_settings_prefixes>SQL_</custom_settings_prefixes>
  <!-- The system database is deny-by-default, so an org-fenced tenant cannot read
       server metadata no row policy covers; dfe-engine grants back only what the
       embedded HyperDX needs (governance/ch/models.py TENANT_SYSTEM_TABLES). -->
  <access_control_improvements>
    <select_from_system_db_requires_grant>true</select_from_system_db_requires_grant>
    <select_from_information_schema_requires_grant>true</select_from_information_schema_requires_grant>
  </access_control_improvements>
</clickhouse>
