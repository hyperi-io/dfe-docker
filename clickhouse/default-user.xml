<clickhouse>
  <profiles>
    <default>
      <date_time_input_format>best_effort</date_time_input_format>
      <!-- Async inserts for every writer: async_insert has no table-level
           form, so the default profile (the base every identity inherits) is
           the one seam covering every table; tuned per-identity profiles still
           override. wait=1 keeps insert errors visible to the client. Mirrors
           the k8s clickhouse-cluster chart's extraUsersConfig / dfe-users.xml. -->
      <async_insert>1</async_insert>
      <wait_for_async_insert>1</wait_for_async_insert>
    </default>
  </profiles>
</clickhouse>
