# STAGED - systemd timer driving the self-update oneshot.
[Unit]
Description=Periodically run the DFE docker stack self-update
Documentation=https://github.com/hyperi-io/dfe-docker

[Timer]
# First run 10 min after boot, then every 6h. Randomised jitter avoids a fleet
# stampeding GHCR at the same instant. Persistent catches up a missed run if the
# VM was off.
OnBootSec=10min
OnUnitActiveSec=6h
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
