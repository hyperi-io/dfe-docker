# install.sh fills in the __PLACEHOLDER__ values
[Unit]
Description=DFE docker stack self-update (pin newest published stack, pull, restart)
Documentation=https://github.com/hyperi-io/dfe-docker
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=__DFE_UPDATE_USER__
# Keeps the updater's files group-writable for operators in the group
UMask=0002
WorkingDirectory=__DFE_DOCKER_DIR__
ExecStart=/usr/bin/python3 __DFE_DOCKER_DIR__/ops/daemon-update/self_update.py
TimeoutStartSec=1800
