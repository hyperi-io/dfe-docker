// Installed by install.sh into /etc/polkit-1/rules.d/, with the group substituted.
// Lets members of that group start, stop and restart the updater and the proof
// unit with plain `systemctl`, no sudo. Nothing else changes: other units, enable,
// disable and daemon-reload still ask for root.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    var ours = unit === "dfe-docker-update.service" || unit === "dfe-docker-proof.service";
    var allowed = verb === "start" || verb === "stop" || verb === "restart";
    if (ours && allowed && subject.isInGroup("__DFE_GROUP__")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
