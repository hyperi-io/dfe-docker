# Project:   dfe-docker
# File:      .dockerignore
# Purpose:   Build-context allowlist for docker/dfe-docker.Dockerfile, the one build with this repo root as its context
# Language:  dockerignore
#
# License:   BUSL-1.1
# Copyright: (c) 2026 HYPERI PTY LIMITED

# An allowlist, as init's folder holds only what it names
*

# Secrets stay out: .env, env/, certs/, access-summary.md
!.env.example
!Makefile
!VERSION
!LICENSE
!compose/
!config/
!deployment.example.yaml
!docker-compose.yml
!docker/dfe-docker.requirements.txt
!env.example/
!redpanda/
!resources/
!scripts/
!service_profiles.yaml

# Inside kept directories, tests and bytecode never run
scripts/tests/
**/__pycache__/
**/*.pyc

# build_dev_images.py stages its own contexts, so this skips it
