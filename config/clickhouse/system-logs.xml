<!--
  Project:   dfe-docker
  File:      config/clickhouse/system-logs.xml
  Purpose:   Ages out ClickHouse's own log tables, which the image keeps forever
  Language:  XML

  License:   BUSL-1.1
  Copyright: (c) 2026 HYPERI PTY LIMITED
-->
<clickhouse>
  <!-- Changing a TTL renames the old table to <table>_0 with its rows -->
  <asynchronous_metric_log>
    <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
  </asynchronous_metric_log>
  <metric_log>
    <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
  </metric_log>
  <part_log>
    <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
  </part_log>
  <query_log>
    <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
  </query_log>
  <query_views_log>
    <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
  </query_views_log>
  <text_log>
    <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
  </text_log>

  <!-- Nothing reads it -->
  <trace_log remove="remove"/>
</clickhouse>
