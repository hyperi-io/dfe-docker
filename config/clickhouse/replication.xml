<clickhouse>
  <!-- Makes this server a one-node cluster with its own Keeper, which dfe-engine's Replicated DDL needs -->
  <keeper_server>
    <!-- Only the four-letter commands that read state -->
    <four_letter_word_white_list>ruok,isro,mntr,srvr,stat</four_letter_word_white_list>
    <!-- Existing volumes hold Keeper's log here rather than at the image default, coordination/logs -->
    <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
    <raft_configuration>
      <server><hostname>127.0.0.1</hostname><id>1</id><port>9234</port></server>
    </raft_configuration>
    <server_id>1</server_id>
    <tcp_port>9181</tcp_port>
  </keeper_server>
  <macros>
    <cluster>dfe</cluster>
    <replica>r1</replica>
    <shard>01</shard>
  </macros>
  <remote_servers>
    <dfe>
      <shard>
        <replica><host>127.0.0.1</host><port>9000</port></replica>
      </shard>
    </dfe>
  </remote_servers>
  <!-- Stores the users and roles dfe-engine creates in Keeper -->
  <user_directories replace="replace">
    <users_xml><path>users.xml</path></users_xml>
    <replicated><zookeeper_path>/clickhouse/access/</zookeeper_path></replicated>
  </user_directories>
  <zookeeper>
    <!-- The login every znode is created under, kept out of preprocessed_configs -->
    <identity from_env="DFE_KEEPER_IDENTITY" hide_in_preprocessed="1"/>
    <node><host>127.0.0.1</host><port>9181</port></node>
  </zookeeper>
</clickhouse>
