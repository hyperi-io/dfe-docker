<clickhouse>
  <!-- Mounted over the image's docker_related_config.xml, so Keeper, raft and interserver stay on loopback -->
  <!-- Clients connect through the protocols block instead -->
  <http_port remove="remove"/>
  <!-- Without this, raft listens on every interface -->
  <interserver_listen_host>127.0.0.1</interserver_listen_host>
  <!-- The ports other containers connect to. IPv4 only, because :: fails in Docker -->
  <protocols>
    <http><description>http</description><host>0.0.0.0</host><port>8123</port><type>http</type></http>
    <tcp><description>native protocol</description><host>0.0.0.0</host><port>9000</port><type>tcp</type></tcp>
  </protocols>
  <tcp_port remove="remove"/>
</clickhouse>
