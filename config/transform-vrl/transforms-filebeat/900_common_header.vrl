##############################################################################
# Fit the bundled filebeat pipeline's output to the DFE 2.2 common header.
#
# ECS `tags` is a list of keywords, and the loader hoists the event's `tags`
# straight into `_tags`, which is a ClickHouse JSON column -- an array there is
# rejected with "Cannot read JSON object from JSON element" and the rejection
# fails the whole batch, not the one field. Wrapping the list in an object keeps
# every tag and gives the column the shape it declares. Remove this once
# dfe-loader#139 makes the hoist shape-aware.
##############################################################################

if is_array(.tags) {
    .tags = { "list": array!(.tags) }
}
