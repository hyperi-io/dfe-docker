## Write values unquoted: `make` includes this file

## =============================================================
## Image Registry
## =============================================================
# DOCKER_DEFAULT_PLATFORM=
# IMAGE_REGISTRY=ghcr.io/hyperi-io

## =============================================================
## Container Names
## =============================================================
# DFE_CONTAINER_PREFIX=

## =============================================================
## Host Exposure
## =============================================================
# DFE_BIND_HOST=127.0.0.1
# DFE_BIND_SCOPE=localhost
# DFE_ENGINE_API_EXTERNAL=true
# DFE_HYPERDX_UI_EXTERNAL=true
# DFE_INFRA_UIS_EXTERNAL=true
# DFE_INGRESS_BIND_HOST=0.0.0.0
# DFE_KAFBAT_UI_EXTERNAL=true
# DFE_UI_EXTERNAL=true

## =============================================================
## Console Origin and TLS
## =============================================================
# DFE_EXTERNAL_ORIGIN=http://localhost
# DFE_NETWORK_SUBNET=10.207.0.0/24
# DFE_PROXY_CA_BUNDLE=
# DFE_PROXY_CERT_DIR=./certs
# DFE_PROXY_TLS=false

## =============================================================
## Infra UI Authentication
## =============================================================
# DFE_AUTH_ENABLED=false
# DFE_OAUTH2_PROXY_COOKIE_DOMAIN=
# DFE_OAUTH2_PROXY_COOKIE_SECRET=
# DFE_OAUTH2_PROXY_COOKIE_SECURE=false
# DFE_OAUTH2_PROXY_EXTERNAL_ORIGIN=
# DFE_OAUTH2_PROXY_VERSION=v7.15.5@sha256:8498b0d0ef0a7b29686414000a08aee467f02d0299c9ed1e006a8f33fc017916
# DFE_OIDC_ALLOWED_GROUPS=dfe-infra,dfe-admin
# DFE_OIDC_CLIENT_ID=
# DFE_OIDC_CLIENT_SECRET=
# DFE_OIDC_EMAIL_DOMAINS=*
# DFE_OIDC_ISSUER_URL=

## =============================================================
## OIDC Test-Fixture Login
## =============================================================
# DFE_OIDC_FIXTURE_PASSWORD=
# DFE_OIDC_FIXTURE_USER=dfe-test@dfe-oidc.test
# DFE_OIDC_OKTA_FIXTURE_PASSWORD=
# DFE_OIDC_OKTA_FIXTURE_USER=

## =============================================================
## Resource Limits
## =============================================================
# DFE_BROKER_CPUS=1.5
# DFE_BROKER_MEMORY=2560M
# DFE_CLICKHOUSE_CPUS=2.0
# DFE_CLICKHOUSE_MEMORY=3G
# DFE_HYPERDX_MEMORY=2G
# DFE_SERVICE_CPUS=2.0
# DFE_SERVICE_MEMORY=768M
# DFE_SIDECAR_CPUS=0.5
# DFE_SIDECAR_MEMORY=512M

## =============================================================
## Credentials
