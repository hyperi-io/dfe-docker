# Project:   dfe-docker
# File:      .env.example
# Purpose:   Environment variable template for Docker Compose
# Language:  Bash (dotenv)
#
# License:   FSL-1.1-ALv2
# Copyright: (c) 2026 HYPERI PTY LIMITED
#
# Copy to .env and fill in values:
#   cp .env.example .env

# --- DFE Component Versions ---
# Pin specific versions or use "latest" (default)
# DFE_RECEIVER_VERSION="latest"
# DFE_LOADER_VERSION="latest"

# --- Log Level ---
# Applies to both receiver and loader
# LOG_LEVEL="info"

# --- ClickHouse Port Overrides ---
# Change if defaults (9000/8123) conflict with local services
# CLICKHOUSE_NATIVE_PORT="9000"
# CLICKHOUSE_HTTP_PORT="8123"
