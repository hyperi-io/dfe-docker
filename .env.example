# Project:   dfe-docker
# File:      .env.example
# Purpose:   Environment variable template for Docker Compose
# Language:  Bash (dotenv)
#
# License:   FSL-1.1-ALv2
# Copyright: (c) 2026 HYPERI PTY LIMITED
#
# Copy to .env and fill in values:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Internal transport between dfe-receiver and dfe-loader
# ---------------------------------------------------------------------------
# grpc  — DfeTransport gRPC direct (DEFAULT, target architecture)
#         Receiver → port 50051 → Loader (no broker)
#         Requires transport-grpc wired in dfe-receiver + dfe-loader Cargo.toml
#         See Step 10 in TODO.md
#
# kafka — Apache Kafka KRaft (opt-in, fully working today)
#         Starts Kafka service automatically
#         Use this until transport-grpc is wired in component repos
#
# DFE_TRANSPORT=grpc

# ---------------------------------------------------------------------------
# DFE Component versions
# ---------------------------------------------------------------------------
# Leave blank for latest published image. Pin for reproducible deployments.
#
# DFE_RECEIVER_VERSION=
# DFE_LOADER_VERSION=

# ---------------------------------------------------------------------------
# Registry
# ---------------------------------------------------------------------------
# Default: JFrog Artifactory (jfrog.io/hyperi)
# GHCR switch: uncomment and set to ghcr.io/hyperi-io
#
# JFROG_REGISTRY=jfrog.io/hyperi

# JFrog credentials (required to pull images from private registry)
# JFROG_USERNAME=
# JFROG_TOKEN=

# ---------------------------------------------------------------------------
# ClickHouse
# ---------------------------------------------------------------------------
# Leave CLICKHOUSE_HOST blank to use the Docker ClickHouse container.
# Set to an external host to skip the Docker container (use make up-ext).
#
# CLICKHOUSE_HOST=
# CLICKHOUSE_PORT=9000
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

# Port overrides for Docker ClickHouse (change if defaults conflict locally)
# CLICKHOUSE_NATIVE_PORT=9000
# CLICKHOUSE_HTTP_PORT=8123

# ---------------------------------------------------------------------------
# Log levels
# ---------------------------------------------------------------------------
# RECEIVER_LOG_LEVEL=info
# LOADER_LOG_LEVEL=info
