## ============================================================================
## Image Registry
## ============================================================================
## OCI registry hosting the published dfe-* images. Default is GHCR.
## For cross-arch builds, set DOCKER_DEFAULT_PLATFORM.
#
# DOCKER_DEFAULT_PLATFORM=
# IMAGE_REGISTRY=ghcr.io/hyperi-io


## ============================================================================
## Projects Path (dev override builds)
## ============================================================================
## Absolute path to the parent directory containing DFE service repos.
## Used by docker-compose.override.yml for local builds.
#
# PROJECTS_PATH=/projects


## ============================================================================
## DFE Profile (overrides active_profile in service_profiles.yaml)
## ============================================================================
## Available profiles are defined in service_profiles.yaml at repo root.
#
# DFE_PROFILE=


## ============================================================================
## DFE Components
## ============================================================================
## Leave version blank for latest published image. Pin for reproducible
## deployments.
##
## ----------------------------------------------------------------------------
## General
## ----------------------------------------------------------------------------
# LOG_LEVEL=info
# LOG_FORMAT=text
#
## ----------------------------------------------------------------------------
## DFE Archiver
## ----------------------------------------------------------------------------
# DFE_ARCHIVER_VERSION=
# DFE_ARCHIVER_PROMETHEUS_PORT=9093
#
## ----------------------------------------------------------------------------
## DFE Fetcher
## ----------------------------------------------------------------------------
# DFE_FETCHER_VERSION=
# DFE_FETCHER_INGEST_PORT=8082
# DFE_FETCHER_PROMETHEUS_PORT=9094
#
## ----------------------------------------------------------------------------
## DFE Loader
## ----------------------------------------------------------------------------
# DFE_LOADER_VERSION=
# DFE_LOADER_PROMETHEUS_PORT=9091
# DFE_LOADER_GRPC_PORT=50051
#
## ----------------------------------------------------------------------------
## DFE Receiver
## ----------------------------------------------------------------------------
# DFE_RECEIVER_VERSION=
# DFE_RECEIVER_BEATS_PORT=5044
# DFE_RECEIVER_GRPC_PORT=6000
# DFE_RECEIVER_HEC_PORT=8088
# DFE_RECEIVER_HTTP_PORT=8080
# DFE_RECEIVER_OTLP_GRPC_PORT=4317
# DFE_RECEIVER_OTLP_HTTP_PORT=4318
# DFE_RECEIVER_PROMETHEUS_PORT=9090
#
## ----------------------------------------------------------------------------
## DFE Transform Vector
## ----------------------------------------------------------------------------
# DFE_TRANSFORM_VECTOR_VERSION=
# DFE_TRANSFORM_VECTOR_PROMETHEUS_PORT=9095
# DFE_TRANSFORM_VECTOR_API_PORT=8686
#
## ----------------------------------------------------------------------------
## DFE Transform VRL
## ----------------------------------------------------------------------------
# DFE_TRANSFORM_VRL_VERSION=


## ============================================================================
## ClickHouse
## ============================================================================
## CLICKHOUSE_VERSION pins the public image as tag@digest. It is REQUIRED by docker-compose.yml (no silent `latest` fallback) and kept current by Renovate (see renovate.json). Override in your own .env to run a different build.
## Leave CLICKHOUSE_HOST blank to use the Docker ClickHouse container.
## Set to an external host to skip the Docker container.
#
CLICKHOUSE_VERSION=26.5.1.882@sha256:07afc18d8a9706eb9d85c5c5d2752e5270f91bbc2894caeaecb73e4d0f603bf5 # renovate: datasource=docker depName=clickhouse/clickhouse-server
# CLICKHOUSE_HOST=
# CLICKHOUSE_HTTP_PORT=8123
# CLICKHOUSE_NATIVE_PORT=9000
# CLICKHOUSE_DB=default
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=


## ============================================================================
## Kafka
## ============================================================================
## Selects which Kafka-API broker the `make` commands run.
## Options:
## - redpanda (default): Lightweight, fits 4 GB CI runners
## - apache (opt-in): Real-Kafka testing or fallback
## Leave version blank for latest published image. Pin for reproducible
## deployments.
#
# KAFKA_BACKEND=redpanda
# KAFKA_PLAINTEXT_HOST_PORT=19092
# KAFKA_PLAINTEXT_PORT=9092
#
## ----------------------------------------------------------------------------
## Apache Kafka (opt-in)
## ----------------------------------------------------------------------------
## APACHE_KAFKA_VERSION: required tag@digest pin, kept current by Renovate.
#
APACHE_KAFKA_VERSION=4.3.0@sha256:0be4c9eb3565733612d2836d65636fd611a219ebcf5b4162e5ac259ea0ecb907 # renovate: datasource=docker depName=apache/kafka
# KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:19092
# KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
# KAFKA_CLUSTER_ID=dfe-docker-dev-cluster-01
# KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
# KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:29092
# KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
# KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
# KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
# KAFKA_LISTENERS=PLAINTEXT://:9092,PLAINTEXT_HOST://:19092,CONTROLLER://:29092
# KAFKA_NODE_ID=1
# KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
# KAFKA_PROCESS_ROLES=broker,controller
# KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
# KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
#
## ----------------------------------------------------------------------------
## Redpanda (default)
## ----------------------------------------------------------------------------
## REDPANDA_VERSION: required tag@digest pin, kept current by Renovate.
#
REDPANDA_VERSION=v26.1.9@sha256:8cb52078690728e2b3d1507fc84eda4c07d4d59bd8fa241e9b1cc7eb7de096c9 # renovate: datasource=docker depName=docker.redpanda.com/redpandadata/redpanda
# REDPANDA_MEMORY=1G


## ============================================================================
## Kafka UI (Kafbat)
## ============================================================================
## KAFBAT_VERSION: required tag@digest pin, kept current by Renovate (renovate.json).
## Enabling this (on by default) will start Kafka UI whenever Kafka is created.
#
# KAFBAT_ENABLED=true
KAFBAT_VERSION=v1.5.0@sha256:7cda86a33344160309fdb65146332e4da65db81a945614f2fe32e210803f6fd1 # renovate: datasource=docker depName=ghcr.io/kafbat/kafka-ui
# KAFBAT_DYNAMIC_CONFIG_ENABLED=true
# KAFBAT_KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS=kafka:9092
# KAFBAT_KAFKA_CLUSTERS_0_NAME=dfe-local
# KAFBAT_PORT=8081

## ============================================================================
## Core DFE Components
## ============================================================================
## Leave version blank for latest published image. Pin for reproducible
## deployments.
##
## ----------------------------------------------------------------------------
## General
## ----------------------------------------------------------------------------
# DFE_CORE_ENABLED=true
# 
## ----------------------------------------------------------------------------
## dfe-engine
## ----------------------------------------------------------------------------
# DFE_ENGINE_VERSION=
# DFE_ENGINE_PORT=8003
# DFE_ENGINE_ADMIN_PASSWORD=changeme
# DFE_ENGINE_CONFIG_DIR=/app/config
# DFE_ENGINE_SCHEMAS_DIR=/app/schemas
#
## ----------------------------------------------------------------------------
## dfe-ui
## ----------------------------------------------------------------------------
# DFE_UI_VERSION=
# DFE_UI_PORT=3000
# DFE_UI_NEXTAUTH_SECRET=secret
# DFE_UI_NODE_ENV=production
#
## ----------------------------------------------------------------------------
## dfe-proxy
## ----------------------------------------------------------------------------
DFE_PROXY_VERSION=1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 # renovate: datasource=docker depName=nginx
