## Project:   dfe-docker
## File:      .env.example
## Purpose:   Environment variable template for Docker Compose
## Language:  Bash (dotenv)
##
## License:   BUSL-1.1
## Copyright: (c) 2026 HYPERI PTY LIMITED

## Write values unquoted: `make` includes this file

## =============================================================
## Image Registry
## =============================================================
# DOCKER_DEFAULT_PLATFORM=
# IMAGE_REGISTRY=ghcr.io/hyperi-io

## =============================================================
## Second Stack on This Host
## =============================================================
## Container name prefix, set with a project name and new ports
# DFE_CONTAINER_PREFIX=

## =============================================================
## Host Exposure
## =============================================================
## Operator ports (ClickHouse, Kafka, metrics), keep on loopback
# DFE_BIND_HOST=127.0.0.1
# DFE_INGRESS_BIND_HOST=0.0.0.0

## UI publish address: localhost (127.0.0.1) or all (0.0.0.0)
# DFE_BIND_SCOPE=localhost
# DFE_ENGINE_API_EXTERNAL=true
# DFE_HYPERDX_UI_EXTERNAL=true
## false unpublishes every infra UI, whatever its own flag
# DFE_INFRA_UIS_EXTERNAL=true
# DFE_KAFBAT_UI_EXTERNAL=true
# DFE_UI_EXTERNAL=true

## =============================================================
## Console Origin and TLS
## =============================================================
## Scheme and host a browser reaches this box on, no port
# DFE_EXTERNAL_ORIGIN=http://localhost

# DFE_NETWORK_SUBNET=10.207.0.0/24
## CA chain the e2e tests trust for a private CA
# DFE_PROXY_CA_BUNDLE=
## Holds console.crt and console.key, which `make certs` mints
# DFE_PROXY_CERT_DIR=./certs
## true serves the console over TLS, needs `make down` to flip
# DFE_PROXY_TLS=false

## =============================================================
## Infra UI Authentication
## =============================================================
## true puts an oauth2-proxy in front of Kafbat and HyperDX
# DFE_AUTH_ENABLED=false

# DFE_OAUTH2_PROXY_COOKIE_DOMAIN=
## Minted by `make init`
# DFE_OAUTH2_PROXY_COOKIE_SECRET=
## true behind real TLS, else every sign-in loops
# DFE_OAUTH2_PROXY_COOKIE_SECURE=false
## Follows DFE_EXTERNAL_ORIGIN when unset
# DFE_OAUTH2_PROXY_EXTERNAL_ORIGIN=
# DFE_OAUTH2_PROXY_VERSION=v7.15.5@sha256:8498b0d0ef0a7b29686414000a08aee467f02d0299c9ed1e006a8f33fc017916

## The IdP must send a groups claim, else sign-in is refused
# DFE_OIDC_ALLOWED_GROUPS=dfe-infra,dfe-admin
# DFE_OIDC_CLIENT_ID=
# DFE_OIDC_CLIENT_SECRET=
# DFE_OIDC_EMAIL_DOMAINS=*
# DFE_OIDC_ISSUER_URL=

## =============================================================
## OIDC Test-Fixture Login
## =============================================================
## Throwaway test login the console specs sign in with
# DFE_OIDC_FIXTURE_PASSWORD=
# DFE_OIDC_FIXTURE_USER=dfe-test@dfe-oidc.test

## A per-provider pair, here Okta, wins over the generic one
# DFE_OIDC_OKTA_FIXTURE_PASSWORD=
# DFE_OIDC_OKTA_FIXTURE_USER=

## =============================================================
## Resource Limits
## =============================================================
# DFE_BROKER_CPUS=1.5
## Keep above REDPANDA_MEMORY
# DFE_BROKER_MEMORY=2560M
# DFE_CLICKHOUSE_CPUS=2.0
# DFE_CLICKHOUSE_MEMORY=3G
# DFE_HYPERDX_MEMORY=2G
## Below 2.0 a scalo service gets one worker thread and stalls
# DFE_SERVICE_CPUS=2.0
# DFE_SERVICE_MEMORY=768M
# DFE_SIDECAR_CPUS=0.5
# DFE_SIDECAR_MEMORY=512M

## =============================================================
## Credentials
## =============================================================
## Minted by `make init`
# CLICKHOUSE_PASSWORD=
# DFE_HUNT_RUNNER_CLICKHOUSE_PASSWORD=
# DFE_LOADER_CLICKHOUSE_PASSWORD=
# DFE_OTEL_WRITER_CLICKHOUSE_PASSWORD=
# DFE_QUERY_READER_CLICKHOUSE_PASSWORD=
# HYPERDX_DOCUMENTDB_PASSWORD=

## Minted by `make init`, never changed once ClickHouse has data
# CLICKHOUSE_KEEPER_PASSWORD=

## =============================================================
## Power-On Self Test
## =============================================================
# DFE_POST_DATABASE=dfe
# DFE_POST_ENABLED=true
# DFE_POST_HOST=localhost
# DFE_POST_TABLE=default

## =============================================================
## Dev Source
## =============================================================
# DFE_SRC_CACHE=~/.cache/dfe-docker/src
# DFE_SRC_REF=main
# DFE_SRC_REMOTE=https://github.com/hyperi-io
## Your checkouts instead of the cache, also used by LIVE=1
# DFE_SRC_ROOT=

## =============================================================
## Profile
## =============================================================
## Overrides service_profiles.yaml, e.g. single-kafka
# DFE_PROFILE=

## Each overrides the profile, unset follows it
# DFE_CLICKHOUSE_ENABLED=true
# DFE_CORE_ENABLED=true
# DFE_HYPERDX_ENABLED=false
# DFE_OTEL_ENABLED=false
# KAFBAT_ENABLED=true

## =============================================================
## DFE Components
## =============================================================
## *_VERSION pins come from `make stack VERSION=X.Y.Z`
# DFE_ARCHIVER_PROMETHEUS_PORT=9093
# DFE_ARCHIVER_VERSION=

# DFE_ENGINE_PORT=8003
# DFE_ENGINE_VERSION=

# DFE_FETCHER_INGEST_PORT=8082
# DFE_FETCHER_PROMETHEUS_PORT=9094
# DFE_FETCHER_VERSION=

# DFE_LOADER_GRPC_PORT=50051
# DFE_LOADER_PROMETHEUS_PORT=9091
# DFE_LOADER_VERSION=

# DFE_PROXY_VERSION=

# DFE_RECEIVER_BEATS_PORT=5044
# DFE_RECEIVER_GRPC_PORT=6000
# DFE_RECEIVER_HEC_PORT=8088
# DFE_RECEIVER_HTTP_PORT=8080
# DFE_RECEIVER_MAX_BODY_SIZE=8000000
# DFE_RECEIVER_OTLP_GRPC_PORT=4317
# DFE_RECEIVER_OTLP_HTTP_PORT=4318
# DFE_RECEIVER_PROMETHEUS_PORT=9090
# DFE_RECEIVER_VERSION=

# DFE_TRANSFORM_ELASTIC_PROMETHEUS_PORT=9099
# DFE_TRANSFORM_ELASTIC_VERSION=

# DFE_TRANSFORM_VECTOR_API_PORT=8686
# DFE_TRANSFORM_VECTOR_PROMETHEUS_PORT=9095
# DFE_TRANSFORM_VECTOR_VERSION=

# DFE_TRANSFORM_VRL_VERSION=

# DFE_UI_PORT=3000
# DFE_UI_VERSION=

# LOG_FORMAT=text
# LOG_LEVEL=info

## =============================================================
## ClickHouse
## =============================================================
# CLICKHOUSE_DB=default
## External instance, also set DFE_CLICKHOUSE_ENABLED=false
# CLICKHOUSE_HOST=
# CLICKHOUSE_SECURE=false
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_VERSION=

## Ports the stack dials on an external CLICKHOUSE_HOST
# CLICKHOUSE_EXTERNAL_HTTP_PORT=8123
# CLICKHOUSE_EXTERNAL_NATIVE_PORT=9000

## Host publish of the bundled container only
# CLICKHOUSE_HTTP_PORT=8123
# CLICKHOUSE_NATIVE_PORT=9000

## =============================================================
## Kafka
## =============================================================
## redpanda (BSL) or apache (Apache-2.0)
# KAFKA_BACKEND=redpanda

# APACHE_KAFKA_VERSION=

# REDPANDA_MEMORY=1G
## production with real SMP and MEMORY for a deploy
# REDPANDA_MODE=dev-container
# REDPANDA_SMP=1
# REDPANDA_VERSION=

## An external broker only, the profile sets it otherwise
# DFE_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
## Name external clients connect to, with DFE_BIND_HOST=0.0.0.0
# KAFKA_ADVERTISED_HOST=localhost
# KAFKA_PLAINTEXT_HOST_PORT=19092

# KAFBAT_PORT=8081
# KAFBAT_VERSION=

## =============================================================
## Release Check
## =============================================================
## Every DFE app asks releases.hyperi.io for a newer version
# DFE_VERSION_CHECK_ENABLED=true
# DFE_VERSION_CHECK_SEND_INSTANCE_ID=true

## =============================================================
## Self-Monitoring
## =============================================================
# DFE_OTEL_COLLECTOR_LOG_LEVEL=warn
# DFE_OTEL_COLLECTOR_VERSION=
# DFE_OTEL_DATABASE=dfe
## An external OTLP backend, else the bundled collector
# DFE_OTEL_EXPORTER_ENDPOINT=
# DFE_OTEL_HEALTH_PORT=13133

## =============================================================
## HyperDX
## =============================================================
# DFE_HYPERDX_API_PORT=8000
# DFE_HYPERDX_APP_PORT=8090
## Follows DFE_EXTERNAL_ORIGIN when unset
# DFE_HYPERDX_APP_URL=
## Where the engine reaches HyperDX
# DFE_HYPERDX_BASE_URL=http://hyperdx:8000
## The port the DFE UI iframes, served by dfe-proxy
# DFE_HYPERDX_EMBED_PORT=8091
# DFE_HYPERDX_VERSION=
# HYPERDX_DOCUMENTDB_USER=hyperdx
# HYPERDX_DOCUMENTDB_VERSION=
